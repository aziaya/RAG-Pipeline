# --- Weaviate (local Docker, anonymous access) ---
WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=

# --- Embeddings: llama-server (OpenAI-compatible) ---
EMBED_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=embeddinggemma-2-Q8_0
# EMBED_API_KEY=
# Values containing spaces or | MUST be quoted (an unquoted line stops .env loading silently)
EMBED_QUERY_PREFIX="task: search result | query: "
EMBED_DOC_PREFIX="title: none | text: "

# --- Chat model: llama-server (OpenAI-compatible) used by POST /chat ---
CHAT_BASE_URL=http://127.0.0.1:8082/v1
CHAT_MODEL=gemma-4-e2b-it
# CHAT_API_KEY=
CHAT_TOP_K=4
CHAT_MAX_TOKENS=512
CHAT_TEMPERATURE=0.2
CHAT_TIMEOUT_SECS=300
CHAT_CONTEXT_CHARS=9000
CHAT_DISABLE_THINKING=true
CHAT_MAX_CONCURRENT=2

# --- Chunking ---
CHUNK_TOKENIZER=/Volumes/Workspace/inference/models/embedding/tokenizer/tokenizer.json
CHUNK_MAX_TOKENS=512

# --- API server ---
BIND_ADDR=127.0.0.1:3000
MAX_UPLOAD_MB=50
MAX_CONCURRENT_INGESTS=2
INGEST_TIMEOUT_SECS=600

# --- PDFs (needed because docling uses ort-load-dynamic) ---
# ORT_DYLIB_PATH=/full/path/to/libonnxruntime.dylib

# --- Terminal UI tracing (optional) ---
# Trace filter for the live panel (default: our crate at full detail, dependencies only on warnings)
# RAG_TRACE=rag_pipeline=trace,warn
# Also write the trace to a file while the UI runs
# RAG_LOG_FILE=/tmp/rag-pipeline.log

# --- Retrieval defaults (changeable live in the chat with /settings) ---
RETRIEVAL_MODE=hybrid          # hybrid | semantic | keyword
RETRIEVAL_ALPHA=0.5            # hybrid only: 0 = keywords, 1 = meaning
CHAT_CANDIDATES=20             # passages fetched for the reranker to choose from
CHAT_REWRITE=true              # rewrite follow-up questions into standalone searches
CHAT_STREAM=true               # show answers token by token as they are written

# --- Reranking (optional) ---
# Any /rerank endpoint: llama-server started with --reranking --embedding --pooling rank, Jina, Cohere-compatible
# RERANK_BASE_URL=http://127.0.0.1:8083/v1
RERANK_ENABLED=false
RERANK_MODEL=reranker
RERANK_WEIGHT=0.7              # 0 = keep retrieval order, 1 = reranker order only
# RERANK_API_KEY=
RERANK_TIMEOUT_SECS=30

# --- Saved conversations ---
DATA_DIR=./data                # sessions are stored in ./data/sessions/*.json

# --- Collections ---
# Documents are ingested into a collection; chat and search cover ALL collections unless you pick some.
DEFAULT_COLLECTION=default
