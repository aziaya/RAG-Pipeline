# --- Weaviate (local Docker, anonymous access) ---
WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=

# --- Embeddings: llama-server (OpenAI-compatible) ---
EMBED_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=embeddinggemma-2-Q8_0
# EMBED_API_KEY=
# Values containing spaces or | MUST be quoted (an unquoted line stops .env loading silently)
EMBED_QUERY_PREFIX="task: search result | query: "
EMBED_DOC_PREFIX="title: none | text: "

# --- Chat model: llama-server (OpenAI-compatible) used by POST /chat ---
CHAT_BASE_URL=http://127.0.0.1:8082/v1
CHAT_MODEL=gemma-4-e2b-it
# CHAT_API_KEY=
CHAT_TOP_K=4
CHAT_MAX_TOKENS=512
CHAT_TEMPERATURE=0.2
CHAT_TIMEOUT_SECS=300
CHAT_CONTEXT_CHARS=9000
CHAT_DISABLE_THINKING=true
CHAT_MAX_CONCURRENT=2

# --- Chunking ---
CHUNK_TOKENIZER= # e.g Volumes/Workspace/inference/models/embedding/tokenizer/tokenizer.json
CHUNK_MAX_TOKENS=512

# --- API server ---
BIND_ADDR=127.0.0.1:3000
MAX_UPLOAD_MB=50
MAX_CONCURRENT_INGESTS=2
INGEST_TIMEOUT_SECS=600

